{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && touch dist/.gitkeep",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "curl -s ${HEADSCALE_URL:-http://127.0.0.1:8080}/api/v1/openapi.json -o openapi.json && npx --yes openapi-typescript@7 openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
